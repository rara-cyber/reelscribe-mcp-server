{
  "name": "reelscribe-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for ReelScribe video transcription - transcribe Instagram, TikTok, YouTube, and Facebook videos from any AI assistant",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "reelscribe-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test tests",
    "prebuild": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reelscribe",
    "video-transcription",
    "instagram",
    "tiktok",
    "youtube",
    "facebook",
    "ai-tools"
  ],
  "author": "ReelScribe",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
